# Server-side secrets. All optional; rooms work without them.
GROQ_API_KEY=your_groq_api_key_here
# Relay (TURN) for calls, from Cloudflare Realtime. Flow stops at 950 GB a month to stay in the free tier.
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
CLOUDFLARE_TURN_API_TOKEN=your_turn_key_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ANALYTICS_TOKEN=api_token_with_account_analytics_read
PORT=3000

# Public values for your own Supabase project. Leave unset to use supabase.config.json.
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloudflare Turnstile site key, for the captcha on auth requests (see README).
# PUBLIC_TURNSTILE_SITE_KEY=0x...
